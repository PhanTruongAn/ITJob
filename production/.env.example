# Local Compose settings. Set every blank credential before starting the stack.
POSTGRES_DB=itjob
POSTGRES_USER=itjob
POSTGRES_PASSWORD=

# Keep `update` for a new/local database. Use `validate` after schema setup in a safer environment.
JPA_DDL_AUTO=update

# Generate a unique Base64 JWT signing secret for each environment.
JWT_BASE64_SECRET=

# Cloudinary upload credentials
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_PRESET=it_job

# AWS S3 file storage credentials/settings
AWS_S3_BUCKET_NAME=
AWS_S3_REGION=ap-southeast-1
AWS_S3_ACCESS_KEY=
AWS_S3_SECRET_KEY=

# SMTP credentials
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=

# RabbitMQ credentials (must match the credentials used by the backend)
RABBITMQ_USERNAME=itjob
RABBITMQ_PASSWORD=

# Optional legacy backend property; Google ID token verification currently does not read it.
APP_GOOGLE_CLIENT_ID=
